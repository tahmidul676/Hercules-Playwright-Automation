    "messageRegex": ".*actionTimeout.*|.*Timeout.*waiting for.*click.*|.*Timeout.*waiting for.*fill.*"
  },
  {
    "name": "Navigation timeout",
    "matchedStatuses": [
      "broken"
    ],
    "messageRegex": ".*navigationTimeout.*|.*page.goto.*timeout.*|.*waitForNavigation.*"
