  {
    "name": "Page load failed",
    "matchedStatuses": [
      "broken"
    ],
    "messageRegex": ".*ERR_NAME_NOT_RESOLVED.*|.*ERR_CONNECTION_REFUSED.*|.*Failed to load.*"
